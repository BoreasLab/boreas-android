<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Package visibility for the per-app tunnel list.

      From API 30 an app sees only packages it declares an interest in, so without
      this the Apps screen is empty. The narrow form is used deliberately: this
      grants sight of apps the reader already has a launcher icon for, which is
      exactly the set that screen offers. QUERY_ALL_PACKAGES would grant sight of
      every package on the device, which is more than choosing tunnel membership
      needs and more than a privacy tool should ask for.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!--
          The system VPN settings screen, which owns the always-on switch this app
          cannot set for itself. Declared so the app can ask whether an Activity
          handles it before offering a control that would otherwise do nothing.
        -->
        <intent>
            <action android:name="android.settings.VPN_SETTINGS" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      The foreground-service type declared on the service below. Google lists VPN
      apps, meaning those configured under Settings > Network & Internet > VPN, as
      eligible for the systemExempted type, and from API 34 startForeground() throws
      MissingForegroundServiceTypeException without a declared type.

      Both of these arrive after this app's minSdk and are declared unconditionally
      anyway. <uses-permission> takes android:maxSdkVersion and not a minimum, so
      narrowing them to the versions that define them is not something the manifest
      can express: a platform that does not know a permission name ignores it, which
      is the behavior the narrowing was reaching for.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BoreasApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Boreas">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Boreas">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The sole owner of VPN consent, interface creation, foreground-service
          compliance, routes, and lifecycle callbacks.

          systemExempted is the type Google names for VPN apps. It is not a
          discretionary choice among the seventeen: every other type describes work
          this service does not do, and specialUse is the residual bucket for cases
          the named types miss, which this is not.

          The suppression is narrow and deliberate. Lint reads that type as needing
          FOREGROUND_SERVICE_SYSTEM_EXEMPTED plus SCHEDULE_EXACT_ALARM or
          USE_EXACT_ALARM, but Google documents seven independent ways to qualify and
          holding an exact-alarm permission is only one of them. Being the configured
          VPN is another, and it is the one that applies here. The other six cannot
          be seen in a manifest, so the check assumes the worst.

          Satisfying it as written would mean requesting a permission this app has no
          use for, and USE_EXACT_ALARM is restricted on Play to alarm and calendar
          apps, so asking for it would be a false claim about what this app is. The
          suppression sits on this element rather than in a lint config, so it covers
          this service and nothing else. See docs/verified-inputs.md.
        -->
        <service
            android:name=".service.BoreasVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <!--
              Always-on VPN support. The field defaults to true when absent and
              takes effect from API 27, so this declares the existing behavior
              rather than changing it. It is written out because "the system may
              start this service on its own" is a fact a reader of the manifest
              should not have to infer from a default.
            -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

    </application>
</manifest>
