    <string name="activity_loading">Reading the status snapshot</string>

    <!-- Policy. Owned by the engine; this screen only chooses values. -->
    <string name="policy_intro">The engine decides what happens to every packet. These choices are handed to it when a session starts.</string>
    <string name="policy_group_filtering">Filtering</string>
    <string name="policy_profile_off">Off</string>
    <string name="policy_profile_off_detail">Packets pass through unchanged. Useful for isolating whether Boreas is involved in a problem.</string>
    <string name="policy_profile_standard">Standard</string>
    <string name="policy_profile_standard_detail">Blocks known tracking and advertising endpoints. Leaves everything else alone.</string>
    <string name="policy_profile_strict">Strict</string>
    <string name="policy_profile_strict_detail">Adds telemetry and fingerprinting endpoints. Breaks some apps that treat those endpoints as required.</string>

    <string name="policy_group_inspection">Inspection</string>
    <string name="policy_tls">Inspect TLS connections</string>
    <string name="policy_tls_detail">Lets the engine read inside HTTPS so rules can act on more than the hostname. Requires the Boreas certificate.</string>
    <string name="policy_tls_blocked">Install the certificate first under Settings, then Certificate.</string>

    <string name="policy_group_egress">Egress</string>
    <string name="policy_egress_direct">Direct</string>
    <string name="policy_egress_direct_detail">The engine opens its own sockets. Each one is bypassed around the tunnel before it connects.</string>
    <string name="policy_egress_proxy">Through a proxy</string>
    <string name="policy_egress_proxy_detail">Hands upstream traffic to a proxy you configure.</string>

    <string name="policy_pending_title">Changes are not applied yet</string>
    <string name="policy_pending_detail">The running session keeps its current policy until you restart the tunnel.</string>
    <string name="policy_apply">Restart tunnel to apply</string>

