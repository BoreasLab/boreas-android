    <!-- Typed failures. Each names what happened, what it means, and the next step. -->
    <string name="fail_engine_unavailable_title">The packet engine is not in this build</string>
    <string name="fail_engine_unavailable_detail">Boreas routes packets through a shared Rust engine. This build carries the Android control surface only, so there is nothing to hand the tunnel to.</string>
    <string name="fail_consent_denied_title">Permission refused</string>
    <string name="fail_consent_denied_detail">Android will not create a VPN interface without your approval. Start the tunnel again to see the request a second time.</string>
    <string name="fail_consent_unavailable_title">This device cannot prepare a VPN</string>
    <string name="fail_consent_unavailable_detail">Another app may already hold the always-on VPN slot, or the device policy forbids VPN apps. Check Settings, then Network, then VPN.</string>
    <string name="fail_bypass_denied_title">An upstream socket could not bypass the tunnel</string>
    <string name="fail_bypass_denied_detail">Boreas stops rather than send its own upstream traffic back through itself. Nothing was tunnelled.</string>
    <string name="fail_interface_title">The tunnel interface could not be created</string>
    <string name="fail_interface_detail">Android refused the interface configuration. Check the addresses and routes under Settings, then Tunnel.</string>
    <string name="fail_restart_required_title">The new configuration needs a restart</string>
    <string name="fail_restart_required_detail">The running session kept its previous configuration. Stop and start the tunnel to apply the change.</string>

    <string name="failed_context">This happened %1$s.</string>
    <string name="operation_start">while starting</string>
    <string name="operation_stop">while stopping</string>
    <string name="operation_reconfigure">while applying a configuration change</string>
    <string name="operation_network_change">while following a network change</string>

    <!-- Simulation. Debug builds only, and never silent. -->
    <string name="simulation_title">Simulated session</string>
    <string name="simulation_detail">Every number below is generated in the app. No packets are being tunnelled and no traffic is filtered.</string>
    <string name="simulation_setting">Simulated session</string>
    <string name="simulation_setting_detail">Runs the lifecycle and fills the counters with generated values, so the interface can be reviewed before the packet engine is linked. Debug builds only.</string>

