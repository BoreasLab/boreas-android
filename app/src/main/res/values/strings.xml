    <!--
      Announced phrases. A label and its value are read as one sentence rather than
      two unrelated fragments, and the separator is part of the translation because
      not every language joins them with a colon.
    -->
    <string name="a11y_metric"><xliff:g id="label" example="Bytes in">%1$s</xliff:g>: <xliff:g id="value" example="1.2 MB">%2$s</xliff:g></string>
    <string name="a11y_metric_captioned"><xliff:g id="label" example="Bytes in">%1$s</xliff:g>: <xliff:g id="value" example="1.2 MB">%2$s</xliff:g>. <xliff:g id="caption" example="Since the session started">%3$s</xliff:g></string>

