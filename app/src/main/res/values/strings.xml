    <string name="settings_about">About</string>
    <string name="settings_about_detail">Version and licenses</string>

    <!-- Tunnel. Android addressing, not filtering policy. -->
    <string name="tunnel_title">Tunnel</string>
    <string name="tunnel_intro">Android builds the tunnel interface from these values. They describe the device, not what the engine does with the packets.</string>
    <string name="tunnel_address">IPv4 address</string>
    <string name="tunnel_address_help">The address Boreas gives the tunnel interface. Use a range that nothing else on your network uses.</string>
    <string name="tunnel_mtu">MTU</string>
    <string name="tunnel_mtu_help">Largest packet the interface will carry, in bytes. Between 1280 and 9000.</string>
    <string name="tunnel_dns">DNS servers</string>
    <string name="tunnel_dns_help">One address per line. Leave empty to keep the servers the network supplies.</string>
    <string name="tunnel_locked">Stop the tunnel to change these</string>
    <string name="tunnel_locked_detail">A running session holds the interface it was given. These fields become editable once it stops.</string>

    <string name="error_address_shape">Enter four numbers separated by dots, for example 10.0.0.2</string>
    <string name="error_address_range">Each part must be 255 or less</string>
    <string name="error_mtu_shape">Enter a whole number of bytes</string>
    <string name="error_mtu_range">Must be between 1280 and 9000</string>
    <string name="error_dns_shape">%1$s is not an IP address</string>
    <string name="error_required">Required</string>

    <!-- Always-on VPN. Android owns the switch; Boreas can only report and explain. -->
    <string name="always_on_title">Always-on VPN</string>
    <string name="always_on_explain">Android can start this tunnel by itself and keep it running, including after a restart. Only Android can turn that on, in its own VPN settings.</string>
    <string name="always_on_state_on">On</string>
    <string name="always_on_state_on_detail">Android starts this tunnel without being asked and restarts it if it stops.</string>
    <string name="always_on_state_lockdown">On, with lockdown</string>
    <string name="always_on_state_lockdown_detail">Android also blocks traffic whenever the tunnel is down, so nothing leaves this device unfiltered between sessions.</string>
    <string name="always_on_state_off">Off</string>
    <string name="always_on_state_off_detail">This tunnel runs only while you have started it.</string>
    <string name="always_on_state_unobserved">Not read yet</string>
    <string name="always_on_state_unobserved_detail">Boreas reads this from the running service. Start the tunnel once, or check Android\'s VPN settings.</string>
    <string name="always_on_open_settings">Open Android VPN settings</string>
    <string name="always_on_lockdown_apps">With lockdown on, an app you exclude here gets no network at all while the tunnel is down.</string>
    <string name="shield_always_on">Always-on</string>

    <!-- Apps. -->
    <string name="apps_title">Apps</string>
    <string name="apps_intro">By default every app uses the tunnel. Turn one off to send its traffic straight to the network.</string>
    <string name="apps_search">Search apps</string>
    <plurals name="apps_excluded_count">
        <item quantity="one">%1$d app excluded</item>
        <item quantity="other">%1$d apps excluded</item>
    </plurals>
    <string name="apps_none_excluded">Every app uses the tunnel</string>
    <string name="apps_empty_title">No apps to list</string>
    <string name="apps_empty_detail">Boreas could not read the installed app list.</string>
    <string name="apps_filtered_title">No app matches that search</string>
    <string name="apps_clear_search">Clear search</string>
    <string name="apps_loading">Reading installed apps</string>

    <!-- Certificate. -->
    <string name="certificate_title">Certificate</string>
    <string name="certificate_intro">Reading inside HTTPS requires a certificate that this device trusts. Boreas installs it into your personal certificate store, which you control and can remove at any time.</string>
    <string name="certificate_absent">Not installed</string>
    <string name="certificate_absent_detail">TLS inspection stays off until the certificate is installed.</string>
    <string name="certificate_present">Installed</string>
    <string name="certificate_install">Install certificate</string>
    <string name="certificate_scope_title">What this certificate can and cannot do</string>
    <string name="certificate_scope_user">It goes in the personal store, so only apps that opt in to personal certificates will honor it. Many apps pin their own and will not.</string>
    <string name="certificate_scope_removal">Removing it is an Android action, not a Boreas one. Boreas can open the screen but cannot delete it for you.</string>


    <!-- Diagnostics. -->
    <string name="diagnostics_title">Diagnostics</string>
    <string name="diagnostics_intro">Lifecycle transitions recorded by the service, newest first. This list holds the most recent entries and is not written to disk.</string>
    <string name="diagnostics_empty_title">Nothing recorded</string>
    <string name="diagnostics_empty_detail">Transitions appear here once you start a tunnel.</string>
